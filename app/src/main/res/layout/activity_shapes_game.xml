<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background2">

    <!-- Header with back button and title -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:layout_marginTop="20dp">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="8dp"
            android:background="@drawable/circle_button_background"
            android:src="@drawable/ic_back"
            android:elevation="4dp"
            android:contentDescription="Back" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shapes"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-rounded" />

            <TextView
                android:id="@+id/instructionText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Match the shapes to their outlines!"
                android:textColor="#E6FFFFFF"
                android:textSize="16sp"
                android:fontFamily="sans-serif-rounded" />
        </LinearLayout>
    </LinearLayout>

    <!-- Main game layout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerLayout"
        android:orientation="horizontal">

        <!-- Left side for target drop zones -->
        <FrameLayout
            android:id="@+id/dropZoneContainer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:layout_margin="8dp">

            <FrameLayout
                android:id="@+id/squareDropZone"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_marginStart="40dp"
                android:layout_marginTop="80dp"
                android:background="@drawable/shape_square_outline_modern" />

            <FrameLayout
                android:id="@+id/triangleDropZone"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_marginStart="180dp"
                android:layout_marginTop="180dp"
                android:background="@drawable/shape_triangle_outline_modern" />

            <FrameLayout
                android:id="@+id/hexagonDropZone"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_marginStart="40dp"
                android:layout_marginTop="300dp"
                android:background="@drawable/shape_hexagon_outline_modern" />

            <FrameLayout
                android:id="@+id/circleDropZone"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_marginStart="180dp"
                android:layout_marginTop="400dp"
                android:background="@drawable/shape_circle_outline_modern" />
        </FrameLayout>

        <!-- Right side for draggable shapes -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="8dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/shape_panel_background"
                    android:orientation="vertical">

                    <!-- Reload button -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="16dp"
                        android:paddingEnd="16dp">

                        <ImageView
                            android:id="@+id/reloadButton"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:layout_alignParentEnd="true"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/circle_button_background"
                            android:elevation="4dp"
                            android:padding="12dp"
                            android:src="@drawable/ic_reload"
                            android:contentDescription="Reload" />
                    </RelativeLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="8dp"
                        android:text="Drag Shapes"
                        android:textColor="#4A4A4A"
                        android:textSize="18sp"
                        android:fontFamily="sans-serif-rounded"
                        android:textStyle="bold" />

                    <!-- Triangle shape -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="12dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="4dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="12dp"
                            android:background="@drawable/shape_item_background">

                            <ImageView
                                android:id="@+id/triangleShape"
                                android:layout_width="70dp"
                                android:layout_height="70dp"
                                android:contentDescription="Triangle"
                                android:src="@drawable/shape_triangle_modern" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Triangle"
                                android:textColor="#333333"
                                android:textSize="14sp"
                                android:fontFamily="sans-serif-rounded"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tam Giác"
                                android:textColor="#757575"
                                android:textSize="11sp"
                                android:fontFamily="sans-serif-rounded" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Hexagon shape -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="12dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="4dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="12dp"
                            android:background="@drawable/shape_item_background">

                            <ImageView
                                android:id="@+id/hexagonShape"
                                android:layout_width="70dp"
                                android:layout_height="70dp"
                                android:contentDescription="Hexagon"
                                android:src="@drawable/shape_hexagon_modern" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Hexagon"
                                android:textColor="#333333"
                                android:textSize="14sp"
                                android:fontFamily="sans-serif-rounded"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Lục Giác"
                                android:textColor="#757575"
                                android:textSize="11sp"
                                android:fontFamily="sans-serif-rounded" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Circle shape -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="12dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="4dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="12dp"
                            android:background="@drawable/shape_item_background">

                            <ImageView
                                android:id="@+id/circleShape"
                                android:layout_width="70dp"
                                android:layout_height="70dp"
                                android:contentDescription="Circle"
                                android:src="@drawable/shape_circle_modern" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Circle"
                                android:textColor="#333333"
                                android:textSize="14sp"
                                android:fontFamily="sans-serif-rounded"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Hình Tròn"
                                android:textColor="#757575"
                                android:textSize="11sp"
                                android:fontFamily="sans-serif-rounded" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Rectangle shape -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="12dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="4dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="12dp"
                            android:background="@drawable/shape_item_background">

                            <ImageView
                                android:id="@+id/rectangleShape"
                                android:layout_width="70dp"
                                android:layout_height="70dp"
                                android:contentDescription="Square"
                                android:src="@drawable/shape_rectangle_modern" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Square"
                                android:textColor="#333333"
                                android:textSize="14sp"
                                android:fontFamily="sans-serif-rounded"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Hình Vuông"
                                android:textColor="#757575"
                                android:textSize="11sp"
                                android:fontFamily="sans-serif-rounded" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
            </ScrollView>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</RelativeLayout>