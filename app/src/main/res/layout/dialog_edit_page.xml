<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilPageContent"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nội dung trang"
        app:boxBackgroundColor="@color/white">

        <EditText
            android:id="@+id/etPageContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:lines="6"
            android:maxLines="10" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Gợi ý: Bạn có thể thêm hình ảnh bằng cách chạm vào ảnh trong danh sách các trang."
        android:textSize="12sp"
        android:textStyle="italic" />
        
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Phần tử trang"
        android:textSize="16sp"
        android:textStyle="bold" />
        
    <TextView
        android:id="@+id/tvSelectedPageElements"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Chưa có phần tử nào được chọn"
        android:textSize="14sp" />
        
    <Button
        android:id="@+id/btnSelectPageElements"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Chọn phần tử cho trang" />

</LinearLayout> 