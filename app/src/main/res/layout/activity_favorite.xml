<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main"
    android:background="@drawable/favorite_background">

    <!-- Background gradient drawable (create in res/drawable/favorite_background.xml) -->
    <!--

    -->

    <!-- Decorative elements -->
    <ImageView
        android:id="@+id/topLeftCloud"
        android:layout_width="100dp"
        android:layout_height="80dp"
        android:src="@drawable/cloudy"
        android:alpha="0.7"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="-15dp"
        android:layout_marginStart="-15dp"
        android:contentDescription="Decorative cloud" />

    <ImageView
        android:id="@+id/bottomRightCloud"
        android:layout_width="120dp"
        android:layout_height="90dp"
        android:src="@drawable/cloudy"
        android:alpha="0.6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="-20dp"
        android:layout_marginEnd="-20dp"
        android:contentDescription="Decorative cloud" />

    <!-- Top Bar with animation -->
    <androidx.cardview.widget.CardView
        android:id="@+id/topBarCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:background="@drawable/background_filpcard"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/backButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_back"
                android:tint="#d7edf9"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:contentDescription="Back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="My Favorites"
                android:textColor="#d7edf9"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="@font/kids_font" />

            <ImageView
                android:id="@+id/starAnimation"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_star"
                android:tint="#d7edf9"
                android:contentDescription="Favorite star" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Tabs for switching between Music and Stories -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintTop_toBottomOf="@id/topBarCard"
        app:tabBackground="@drawable/tab_selector"
        app:tabTextColor="#8D6E63"
        app:tabSelectedTextColor="#4E342E"
        app:tabIndicatorHeight="0dp"
        app:tabRippleColor="@android:color/transparent"
        app:tabGravity="fill"
        app:tabMode="fixed">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Music"
            android:icon="@drawable/listen" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stories"
            android:icon="@drawable/lullaby" />
    </com.google.android.material.tabs.TabLayout>

    <!-- ViewPager2 for swiping between Music and Stories -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tabLayout"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Content for Music Fragment -->
    <!-- This would be in a separate fragment layout file -->
    <!-- fragment_favorite_music.xml -->
    <!-- Empty state (for when no favorites exist) -->

</androidx.constraintlayout.widget.ConstraintLayout>