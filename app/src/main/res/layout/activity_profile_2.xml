<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E3F2FD">

    <!-- Thanh tiêu đề -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#50a6fd"
        android:elevation="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/back_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back"
            android:padding="8dp"
            android:tint="@color/white"
            android:background="@android:color/transparent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginStart="16dp"/>

        <TextView
            android:id="@+id/profile_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PROFILE"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/kids_font"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <ImageView
            android:id="@+id/setting_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/profile_setting"
            android:padding="8dp"
            android:background="@android:color/transparent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginEnd="16dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Hình nền Profile -->
    <RelativeLayout
        android:id="@+id/profile_background"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:background="#42A5F5"
        app:layout_constraintTop_toBottomOf="@id/header">

        <!-- Avatar with Badge -->
        <FrameLayout
            android:id="@+id/avatar_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="20dp">

            <!-- Circle Progress -->
            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/level_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:progress="75"
                app:indicatorColor="#88de4a"
                app:indicatorDirectionCircular="clockwise"
                app:indicatorSize="120dp"
                app:trackColor="#D0D0D0"
                app:trackThickness="8dp" />

            <!-- Avatar Background -->
            <androidx.cardview.widget.CardView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center"
                app:cardCornerRadius="50dp">

                <ImageView
                    android:id="@+id/avatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/avt" />
            </androidx.cardview.widget.CardView>

            <!-- Level Badge -->
            <TextView
                android:id="@+id/level_badge"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/circular_button_background"
                android:gravity="center"
                android:text="1"
                android:textColor="#4CAF50"
                android:textSize="18sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Cấp độ -->
        <androidx.cardview.widget.CardView
            android:id="@+id/level_card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="125dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp">

            <TextView
                android:id="@+id/level"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#15caef"
                android:gravity="center"
                android:paddingHorizontal="20dp"
                android:paddingVertical="6dp"
                android:text="Beginner"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />
        </androidx.cardview.widget.CardView>

        <!-- Điểm số -->
        <TextView
            android:id="@+id/score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/level_card"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="8dp"
            android:text="1536"
            android:textColor="#FFEB3B"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_below="@id/level_card"
            android:layout_alignTop="@id/score"
            android:layout_marginStart="4dp"
            android:layout_marginTop="2dp"
            android:layout_toEndOf="@id/score"
            android:src="@drawable/ic_star" />
    </RelativeLayout>

    <!-- Thêm ScrollView cho phần nội dung chính -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/profile_background"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Thanh ngày và thứ -->
            <androidx.cardview.widget.CardView
                android:id="@+id/date_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:id="@+id/date_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:paddingVertical="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="S"
                            android:textAlignment="center"
                            android:textColor="#757575"
                            android:textSize="12sp"/>
                        <TextView
                            android:id="@+id/day_sun"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="18"
                            android:textAlignment="center"
                            android:textColor="#212121"
                            android:textSize="14sp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/selected_day_background">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="M"
                            android:textAlignment="center"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"/>
                        <TextView
                            android:id="@+id/day_mon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="19"
                            android:textAlignment="center"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="T"
                            android:textAlignment="center"
                            android:textColor="#757575"
                            android:textSize="12sp"/>
                        <TextView
                            android:id="@+id/day_tue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="20"
                            android:textAlignment="center"
                            android:textColor="#212121"
                            android:textSize="14sp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/selected_item_background">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="W"
                            android:textAlignment="center"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"/>
                        <TextView
                            android:id="@+id/day_wed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="21"
                            android:textAlignment="center"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="T"
                            android:textAlignment="center"
                            android:textColor="#757575"
                            android:textSize="12sp"/>
                        <TextView
                            android:id="@+id/day_thu"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="22"
                            android:textAlignment="center"
                            android:textColor="#212121"
                            android:textSize="14sp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="F"
                            android:textAlignment="center"
                            android:textColor="#757575"
                            android:textSize="12sp"/>
                        <TextView
                            android:id="@+id/day_fri"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="23"
                            android:textAlignment="center"
                            android:textColor="#212121"
                            android:textSize="14sp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="S"
                            android:textAlignment="center"
                            android:textColor="#757575"
                            android:textSize="12sp"/>
                        <TextView
                            android:id="@+id/day_sat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="24"
                            android:textAlignment="center"
                            android:textColor="#212121"
                            android:textSize="14sp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Beginner Section -->
            <androidx.cardview.widget.CardView
                android:id="@+id/beginner_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Beginner:"
                            android:textColor="#212121"
                            android:textSize="18sp"
                            android:textStyle="bold"/>

                        <ProgressBar
                            android:id="@+id/vocabulary_progress"
                            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                            android:layout_width="80dp"
                            android:layout_height="8dp"
                            android:progress="35"
                            android:progressTint="#8BC34A"/>
                    </LinearLayout>

                    <!-- Achievements Row 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp">

                        <ImageView
                            android:id="@+id/achievement_1"
                            android:layout_width="0dp"
                            android:layout_height="80dp"
                            android:layout_weight="1"
                            android:src="@drawable/back_game"
                            android:scaleType="fitCenter"
                            android:padding="8dp"/>

                        <ImageView
                            android:id="@+id/achievement_2"
                            android:layout_width="0dp"
                            android:layout_height="80dp"
                            android:layout_weight="1"
                            android:src="@drawable/back_game"
                            android:scaleType="fitCenter"
                            android:padding="8dp"/>

                        <ImageView
                            android:id="@+id/achievement_3"
                            android:layout_width="0dp"
                            android:layout_height="80dp"
                            android:layout_weight="1"
                            android:src="@drawable/back_game"
                            android:scaleType="fitCenter"
                            android:padding="8dp"/>
                    </LinearLayout>

                    <!-- Achievements Row 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp">

                        <ImageView
                            android:id="@+id/achievement_4"
                            android:layout_width="0dp"
                            android:layout_height="80dp"
                            android:layout_weight="1"
                            android:src="@drawable/back_game"
                            android:scaleType="fitCenter"
                            android:padding="8dp"/>

                        <ImageView
                            android:id="@+id/achievement_5"
                            android:layout_width="0dp"
                            android:layout_height="80dp"
                            android:layout_weight="1"
                            android:src="@drawable/back_game"
                            android:scaleType="fitCenter"
                            android:padding="8dp"/>

                        <ImageView
                            android:id="@+id/achievement_6"
                            android:layout_width="0dp"
                            android:layout_height="80dp"
                            android:layout_weight="1"
                            android:src="@drawable/back_game"
                            android:scaleType="fitCenter"
                            android:padding="8dp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Middle Section -->
            <androidx.cardview.widget.CardView
                android:id="@+id/middle_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Middle:"
                            android:textColor="#212121"
                            android:textSize="18sp"
                            android:textStyle="bold"/>

                        <ProgressBar
                            android:id="@+id/reading_progress"
                            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                            android:layout_width="80dp"
                            android:layout_height="8dp"
                            android:progress="20"
                            android:progressTint="#8BC34A"/>
                    </LinearLayout>
                    <!-- Achievements Row 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp">

                        <ImageView
                            android:id="@+id/achievement_7"
                            android:layout_width="0dp"
                            android:layout_height="80dp"
                            android:layout_weight="1"
                            android:src="@drawable/back_game"
                            android:scaleType="fitCenter"
                            android:padding="8dp"/>

                        <ImageView
                            android:id="@+id/achievement_8"
                            android:layout_width="0dp"
                            android:layout_height="80dp"
                            android:layout_weight="1"
                            android:src="@drawable/back_game"
                            android:scaleType="fitCenter"
                            android:padding="8dp"/>

                        <ImageView
                            android:id="@+id/achievement_9"
                            android:layout_width="0dp"
                            android:layout_height="80dp"
                            android:layout_weight="1"
                            android:src="@drawable/back_game"
                            android:scaleType="fitCenter"
                            android:padding="8dp"/>
                    </LinearLayout>

                    <!-- Achievements Row 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp">

                        <ImageView
                            android:id="@+id/achievement_10"
                            android:layout_width="0dp"
                            android:layout_height="80dp"
                            android:layout_weight="1"
                            android:src="@drawable/back_game"
                            android:scaleType="fitCenter"
                            android:padding="8dp"/>

                        <ImageView
                            android:id="@+id/achievement_11"
                            android:layout_width="0dp"
                            android:layout_height="80dp"
                            android:layout_weight="1"
                            android:src="@drawable/back_game"
                            android:scaleType="fitCenter"
                            android:padding="8dp"/>

                        <ImageView
                            android:id="@+id/achievement_12"
                            android:layout_width="0dp"
                            android:layout_height="80dp"
                            android:layout_weight="1"
                            android:src="@drawable/back_game"
                            android:scaleType="fitCenter"
                            android:padding="8dp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Master Section -->
            <androidx.cardview.widget.CardView
                android:id="@+id/master_skills_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Master:"
                            android:textColor="#212121"
                            android:textSize="18sp"
                            android:textStyle="bold"/>

                        <ProgressBar
                            android:id="@+id/master_progress"
                            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                            android:layout_width="80dp"
                            android:layout_height="8dp"
                            android:progress="5"
                            android:progressTint="#FFC107"/>
                    </LinearLayout>

                    <!-- Achievements Row 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp">

                        <ImageView
                            android:id="@+id/achievement_master_1"
                            android:layout_width="0dp"
                            android:layout_height="80dp"
                            android:layout_weight="1"
                            android:src="@drawable/back_game"
                            android:scaleType="fitCenter"
                            android:padding="8dp"
                            android:alpha="0.5"/>

                        <ImageView
                            android:id="@+id/achievement_master_2"
                            android:layout_width="0dp"
                            android:layout_height="80dp"
                            android:layout_weight="1"
                            android:src="@drawable/back_game"
                            android:scaleType="fitCenter"
                            android:padding="8dp"
                            android:alpha="0.5"/>

                        <ImageView
                            android:id="@+id/achievement_master_3"
                            android:layout_width="0dp"
                            android:layout_height="80dp"
                            android:layout_weight="1"
                            android:src="@drawable/back_game"
                            android:scaleType="fitCenter"
                            android:padding="8dp"
                            android:alpha="0.5"/>
                    </LinearLayout>

                    <!-- Achievements Row 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp">

                        <ImageView
                            android:id="@+id/achievement_master_4"
                            android:layout_width="0dp"
                            android:layout_height="80dp"
                            android:layout_weight="1"
                            android:src="@drawable/back_game"
                            android:scaleType="fitCenter"
                            android:padding="8dp"
                            android:alpha="0.5"/>

                        <ImageView
                            android:id="@+id/achievement_master_5"
                            android:layout_width="0dp"
                            android:layout_height="80dp"
                            android:layout_weight="1"
                            android:src="@drawable/back_game"
                            android:scaleType="fitCenter"
                            android:padding="8dp"
                            android:alpha="0.5"/>

                        <ImageView
                            android:id="@+id/achievement_master_6"
                            android:layout_width="0dp"
                            android:layout_height="80dp"
                            android:layout_weight="1"
                            android:src="@drawable/back_game"
                            android:scaleType="fitCenter"
                            android:padding="8dp"
                            android:alpha="0.5"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>