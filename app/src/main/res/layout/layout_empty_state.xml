<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/emptyStateAnimation"
        android:layout_width="200dp"
        android:layout_height="200dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.4"
        app:lottie_rawRes="@raw/empty_favorite"
        app:lottie_autoPlay="true"
        app:lottie_loop="true" />

    <TextView
        android:id="@+id/emptyStateTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No Favorites Yet"
        android:textSize="24sp"
        android:textColor="#5D4037"
        android:textStyle="bold"
        android:fontFamily="@font/kids_font"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/emptyStateAnimation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/emptyStateMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Add your favorite music and stories by tapping the heart icon!"
        android:textSize="16sp"
        android:textColor="#8D6E63"
        android:fontFamily="@font/kids_font"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="32dp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/emptyStateTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/exploreButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Explore Content"
        android:textAllCaps="false"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"
        android:textSize="16sp"
        android:fontFamily="@font/kids_font"
        app:cornerRadius="20dp"
        android:backgroundTint="#FF9800"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/emptyStateMessage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>