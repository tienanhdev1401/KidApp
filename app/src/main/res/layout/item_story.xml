<androidx.cardview.widget.CardView android:id="@+id/story1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/thumbnailContainer"
            android:layout_width="110dp"
            android:layout_height="70dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/storyThumbnailImg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/story_tortoise_hare"
                    android:contentDescription="Story thumbnail" />
            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/storyTitleTv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="The Tortoise and the Hare"
            android:textColor="#333333"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintStart_toEndOf="@id/thumbnailContainer"
            app:layout_constraintEnd_toStartOf="@id/favoriteBtn"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/storyInfoTv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="5 min • Aesop's Fables"
            android:textColor="#777777"
            android:textSize="14sp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="4dp"
            app:layout_constraintStart_toEndOf="@id/thumbnailContainer"
            app:layout_constraintEnd_toStartOf="@id/favoriteBtn"
            app:layout_constraintTop_toBottomOf="@id/storyTitleTv" />



        <com.google.android.material.button.MaterialButton
            android:id="@+id/favoriteBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:iconGravity="textEnd"
            app:backgroundTint="@android:color/transparent"
            app:iconPadding="2dp"
            app:iconSize="30dp"
            app:icon="@drawable/love"
            app:iconTint="#FF6F00"
            app:strokeWidth="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:contentDescription="Favorite" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>