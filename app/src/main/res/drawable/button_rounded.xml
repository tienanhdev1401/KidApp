<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Trạng thái khi nút được nhấn -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="25dp" />
            <solid android:color="@color/primaryDarkColor" /> <!-- Màu khi nhấn -->
            <stroke
                android:width="1dp"
                android:color="@color/primaryDarkColor" />
        </shape>
    </item>

    <!-- Trạng thái mặc định -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="25dp" /> <!-- Độ bo tròn góc -->
            <solid android:color="@color/primaryColor" /> <!-- Màu nền mặc định -->
            <stroke
                android:width="1dp"
                android:color="@color/primaryColor" /> <!-- Màu viền -->
        </shape>
    </item>
</selector>